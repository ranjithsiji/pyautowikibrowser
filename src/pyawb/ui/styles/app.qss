/* PyAutoWikiBrowser application stylesheet: Wikimedia Codex's components drawn with Codex's design
   tokens. Placeholders (dollar + Codex token name with "-" written "_") are filled by pyawb.ui.theme;
   $icon_check, $icon_up and $icon_down are files with Codex's check and chevron icons.
   Component rules follow Codex's own styles (design-codex packages/codex/src/components, the .vue files
   and themes/mixins); QSS cannot draw box-shadow focus rings, so focus is the border colour only.
   Keep rules direction-neutral (symmetric padding/margins) so RTL layouts work unchanged.
   Fonts are left to the OS so every script (Arabic, Malayalam, CJK...) gets a shaping font. */

QWidget {
    background: $background_color_neutral_subtle;
    color: $color_base;
    selection-background-color: $background_color_progressive_subtle__active;
    selection-color: $color_emphasized;
}

QMainWindow::separator { background: $border_color_subtle; width: 1px; height: 1px; }

/* TextInput / TextArea */
QPlainTextEdit, QTextEdit, QLineEdit, QSpinBox, QComboBox, QListView, QTreeView, QTableView {
    background: $background_color_base;
    border: $border_width_base solid $border_color_interactive;
    border-radius: $border_radius_base;
}
QLineEdit, QComboBox { padding: 4px 8px; min-height: 22px; }
QSpinBox { padding: 4px; min-height: 22px; }
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border: none;
    background: transparent;
}
QSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: $background_color_interactive_subtle__hover; }
QSpinBox::up-arrow { image: url($icon_up); width: 10px; height: 10px; }
QSpinBox::down-arrow { image: url($icon_down); width: 10px; height: 10px; }
QPlainTextEdit:hover, QTextEdit:hover, QLineEdit:hover, QSpinBox:hover, QComboBox:hover {
    border-color: $border_color_interactive__hover;
}
QPlainTextEdit:focus, QTextEdit:focus, QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: $border_color_progressive__focus;
}
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled, QPlainTextEdit:disabled {
    background: $background_color_disabled_subtle;
    border-color: $border_color_disabled;
    color: $color_disabled;
}
QPlainTextEdit#editor { padding: 4px; border-color: $border_color_base; border-radius: 0; }
QPlainTextEdit#editor:focus { border-color: $border_color_progressive__focus; }

/* Button (default): Codex Button.vue + themes/mixins/button.less. QSS min-height is the content
   box: min-size-interactive-pointer (32px) minus the two 1px borders. */
QPushButton, QToolButton {
    background: $background_color_interactive_subtle;
    border: $border_width_base solid $border_color_interactive;
    border-radius: $border_radius_base;
    color: $color_neutral;
    font-weight: bold;
    min-height: 30px;
    padding: 0 $spacing_horizontal_button;
}
QPushButton:hover, QToolButton:hover {
    background: $background_color_interactive_subtle__hover;
    border-color: $border_color_interactive__hover;
}
QPushButton:pressed, QToolButton:pressed, QToolButton:checked {
    background: $background_color_interactive_subtle__active;
    border-color: $border_color_interactive__active;
}
QPushButton:focus, QToolButton:focus { border-color: $border_color_progressive__focus; }
QPushButton:disabled, QToolButton:disabled {
    background: $background_color_disabled;
    border-color: $border_color_transparent;
    color: $color_inverted;
}

/* Button, primary weight: progressive and destructive actions */
QPushButton[primary="true"] {
    background: $background_color_progressive;
    border-color: $border_color_transparent;
    color: $color_inverted_fixed;
}
QPushButton[primary="true"]:hover { background: $background_color_progressive__hover; }
QPushButton[primary="true"]:pressed { background: $background_color_progressive__active; }
QPushButton[primary="true"]:focus { border-color: $border_color_progressive__focus; }
QPushButton[primary="true"][destructive="true"] { background: $background_color_destructive; }
QPushButton[primary="true"][destructive="true"]:hover { background: $background_color_destructive__hover; }
QPushButton[primary="true"][destructive="true"]:pressed { background: $background_color_destructive__active; }

/* Button, normal weight, destructive action */
QPushButton[destructive="true"] {
    background: $background_color_destructive_subtle;
    border-color: $border_color_destructive;
    color: $color_destructive;
}
QPushButton[destructive="true"]:hover {
    background: $background_color_destructive_subtle__hover;
    border-color: $border_color_destructive__hover;
    color: $color_destructive__hover;
}
QPushButton[destructive="true"]:pressed {
    background: $background_color_destructive_subtle__active;
    border-color: $border_color_destructive__active;
    color: $color_destructive__active;
}

/* Button, quiet weight: tool buttons in toolbars (autoRaise); icon-only ones are square */
QToolButton[autoRaise="true"] {
    background: $background_color_transparent;
    border-color: $border_color_transparent;
    color: $color_neutral;
    min-width: 30px;
    padding: 0 6px;
}
QToolButton[autoRaise="true"]:hover { background: $background_color_interactive_subtle__hover; }
QToolButton[autoRaise="true"]:pressed { background: $background_color_interactive_subtle__active; }
QToolButton[autoRaise="true"]:checked {
    background: $background_color_progressive_subtle__active;
    color: $color_progressive__active;
}
QToolButton[autoRaise="true"]:focus { border-color: $border_color_progressive__focus; }
QToolButton[autoRaise="true"]:disabled {
    background: $background_color_transparent;
    color: $color_disabled;
}

/* Checkbox and Radio */
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: $border_width_base solid $border_color_interactive;
    background: $background_color_base;
}
QCheckBox::indicator { border-radius: $border_radius_base; }
QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: $border_color_interactive__hover;
}
QCheckBox::indicator:checked {
    background: $background_color_input_binary__checked;
    border-color: $background_color_input_binary__checked;
    image: url($icon_check);
}
QRadioButton::indicator:checked {
    background: $background_color_base;
    border: 6px solid $background_color_input_binary__checked;
    width: 8px;
    height: 8px;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background: $background_color_disabled_subtle;
    border-color: $border_color_disabled;
}

/* Table and list selection */
QHeaderView::section {
    background: $background_color_interactive_subtle;
    border: none;
    border-bottom: $border_width_base solid $border_color_base;
    font-weight: bold;
    padding: 6px 8px;
}
QListView::item:hover, QTreeView::item:hover { background: $background_color_interactive_subtle__hover; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background: $background_color_progressive_subtle;
    color: $color_progressive;
}

/* Tabs (quiet): the current tab is progressive with a thick underline */
QTabWidget::pane { border: none; border-top: $border_width_base solid $border_color_subtle; top: -1px; }
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: $border_width_thick solid transparent;
    color: $color_base;
    font-weight: bold;
    padding: 6px 12px;
    margin: 0 1px;
}
QTabBar::tab:hover { color: $color_base__hover; border-bottom-color: $border_color_interactive__hover; }
QTabBar::tab:selected { color: $color_progressive; border-bottom-color: $border_color_progressive__focus; }

/* Fieldset, Menu, bars */
QGroupBox {
    border: $border_width_base solid $border_color_subtle;
    border-radius: $border_radius_base;
    margin-top: 14px;
    padding: 8px;
}
QGroupBox::title { subcontrol-origin: margin; padding: 0 4px; color: $color_subtle; font-weight: bold; }
QMenuBar { background: $background_color_neutral_subtle; border-bottom: $border_width_base solid $border_color_subtle; }
QMenuBar::item { padding: 4px 8px; background: transparent; }
QMenuBar::item:selected { background: $background_color_interactive_subtle__hover; }
QMenu {
    background: $background_color_base;
    border: $border_width_base solid $border_color_base;
    border-radius: $border_radius_base;
    padding: 4px 0;
}
QMenu::item { padding: 6px 12px; }
QMenu::item:selected { background: $background_color_interactive_subtle__hover; color: $color_emphasized; }
QMenu::item:disabled { color: $color_disabled; }
QMenu::separator { height: 1px; background: $border_color_muted; margin: 4px 0; }
QToolBar { background: $background_color_neutral_subtle; border: none; spacing: 4px; padding: 2px; }
QStatusBar {
    background: $background_color_interactive_subtle;
    border-top: $border_width_base solid $border_color_subtle;
    color: $color_subtle;
}
QToolTip {
    background: $background_color_base;
    color: $color_base;
    border: $border_width_base solid $border_color_base;
    border-radius: $border_radius_base;
    padding: 4px 8px;
}

/* WikiEditor toolbar: a band on top of the editor, framed with it, as in WikiEditor */
QWidget#wikiEditorToolbar {
    background: $background_color_interactive_subtle;
    border: $border_width_base solid $border_color_base;
    border-bottom: none;
}
QWidget#wikiEditorToolbarRow { background: transparent; }
QLabel#wikiEditorGroupLabel { background: transparent; color: $color_subtle; padding: 0 4px; }
QListWidget#bookletIndex, QListWidget#specialCharacters, QTextBrowser#helpBrowser {
    background: $background_color_base;
    border-color: $border_color_subtle;
}

/* Scrollbars: thin and identical everywhere (no native overlay vs. classic differences) */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle { background: $border_color_base; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: $border_color_interactive; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QSplitter::handle { background: $border_color_subtle; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
