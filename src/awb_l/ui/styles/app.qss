/* AWB-L application stylesheet. Colour placeholders (dollar + name) are filled by awb_l.ui.theme.
   Keep rules direction-neutral (symmetric padding/margins) so RTL layouts work unchanged.
   Fonts are left to the OS so every script (Arabic, Malayalam, CJK...) gets a shaping font. */

QWidget {
    background: $bg;
    color: $text;
    selection-background-color: $selection;
    selection-color: $text;
}

QMainWindow::separator { background: $border; width: 1px; height: 1px; }

/* Text inputs */
QPlainTextEdit, QTextEdit, QLineEdit, QSpinBox, QComboBox, QListView, QTreeView, QTableView {
    background: $surface;
    border: 1px solid $border;
    border-radius: 4px;
}
QLineEdit, QSpinBox, QComboBox { padding: 4px 6px; min-height: 18px; }
QPlainTextEdit:focus, QTextEdit:focus, QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: $accent;
}
QPlainTextEdit#editor { padding: 4px; }

/* Buttons */
QPushButton, QToolButton {
    background: $surface_alt;
    border: 1px solid $border_strong;
    border-radius: 4px;
    padding: 5px 12px;
}
QPushButton:hover, QToolButton:hover { border-color: $accent; }
QPushButton:pressed, QToolButton:pressed { background: $border; }
QPushButton:disabled, QToolButton:disabled { color: $text_muted; border-color: $border; }
QPushButton[primary="true"] {
    background: $accent;
    border-color: $accent;
    color: $accent_text;
    font-weight: bold;
}
QPushButton[primary="true"]:hover { background: $accent_hover; border-color: $accent_hover; }
QPushButton[destructive="true"] { color: $danger; border-color: $danger; }

/* Check boxes and radio buttons: an explicit outline so they stay visible in dark mode */
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid $border_strong;
    background: $surface;
}
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: $accent; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: $accent;
    border-color: $accent;
}

/* Lists and tables */
QHeaderView::section {
    background: $surface_alt;
    border: none;
    border-bottom: 1px solid $border;
    padding: 4px 6px;
}
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background: $selection;
    color: $text;
}

/* Tabs */
QTabWidget::pane { border: 1px solid $border; border-radius: 4px; top: -1px; }
QTabBar::tab {
    background: $surface_alt;
    border: 1px solid $border;
    padding: 5px 12px;
    margin: 0 1px;
}
QTabBar::tab:selected { background: $surface; border-bottom-color: $surface; }
QTabBar::tab:!selected:hover { color: $accent; }

/* Group boxes, menus, bars */
QGroupBox {
    border: 1px solid $border;
    border-radius: 4px;
    margin-top: 14px;
    padding: 8px;
}
QGroupBox::title { subcontrol-origin: margin; padding: 0 4px; color: $text_muted; }
QMenuBar { background: $bg; border-bottom: 1px solid $border; }
QMenuBar::item { padding: 4px 8px; background: transparent; }
QMenuBar::item:selected, QMenu::item:selected { background: $selection; }
QMenu { background: $surface; border: 1px solid $border; padding: 4px; }
QMenu::item { padding: 4px 16px; }
QMenu::separator { height: 1px; background: $border; margin: 4px 0; }
QToolBar { background: $bg; border: none; spacing: 4px; padding: 2px; }
QStatusBar { background: $surface_alt; border-top: 1px solid $border; color: $text_muted; }
QToolTip { background: $surface; color: $text; border: 1px solid $border_strong; padding: 4px; }

/* Scrollbars: thin and identical everywhere (no native overlay vs. classic differences) */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle { background: $border_strong; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: $text_muted; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QSplitter::handle { background: $border; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
